/* Base16 Wallpick - rofi launcher, generated by flavours */
/* Edit flavours/templates/rofi/templates/launcher.mustache, not this file */
/* Colors and opacity (0.8 = cc) mirror kitty */

* {
    background:  #2a261ecc;
    foreground:  #607f6c;
    input-bg:    #484743cc;
    prompt:      #a4abb0;
    selected-bg: #c3cdd5;
    selected-fg: #2a261e;
    border:      #868a8c;

    background-color: transparent;
    text-color: @foreground;
    font: "CaskaydiaCove Nerd Font Mono 12";
}

window {
    location: center;
    anchor: center;
    width: 640px;
    padding: 5px;
    border: 1px;
    border-color: @border;
    border-radius: 8px;
    background-color: @background;
}

mainbox {
    padding: 5px;
    spacing: 5px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 6px 8px;
    spacing: 8px;
    border-radius: 4px;
    background-color: @input-bg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @prompt;
}

entry {
    placeholder: "";
}

listview {
    lines: 10;
    scrollbar: false;
    spacing: 2px;
    cycle: true;
}

element {
    padding: 5px 8px;
    spacing: 10px;
    border-radius: 4px;
}

element selected {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-icon {
    size: 1.2em;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}